# ================================================
# PORTFOLIO CMS - BACKEND ENVIRONMENT VARIABLES
# ================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ================================================

# Server Configuration
NODE_ENV=development
PORT=5001

# ================================================
# SUPABASE CONFIGURATION
# ================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Supabase Project URL
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Supabase Anonymous Key (for client-side, public access)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (for server-side, full access - KEEP SECRET!)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ================================================
# CLOUDINARY CONFIGURATION
# ================================================
# Get these from: https://cloudinary.com/console

# Cloudinary Cloud Name
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary API Key
CLOUDINARY_API_KEY=your_api_key

# Cloudinary API Secret (KEEP SECRET!)
CLOUDINARY_API_SECRET=your_api_secret

# Cloudinary Upload Preset (optional, for unsigned uploads)
CLOUDINARY_UPLOAD_PRESET=portfolio_preset

# Cloudinary folder for organized storage
CLOUDINARY_FOLDER=portfolio

# ================================================
# CORS & SECURITY
# ================================================
# Frontend domain (for CORS)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Production frontend URL
# FRONTEND_URL=https://your-domain.com
# CORS_ORIGIN=https://your-domain.com
